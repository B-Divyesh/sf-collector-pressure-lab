{
  "name": "collector-pressure-lab-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:site",
    "build:site": "tsc --noEmit -p tsconfig.site.json && vite build",
    "test": "cargo test && npm run test:unit && npm run build:site && npm run test:e2e",
    "test:unit": "vitest run model.test.ts deployment.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.58.2",
    "playwright-core": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
